# NestJS API port.
PORT=3000

# Comma-separated list of frontend origins allowed by API CORS.
WEB_ORIGIN=http://localhost:4200

# Local Docker Postgres connection string from docker-compose.yml.
DATABASE_URL=postgresql://sumer_reel_forge:sumer_reel_forge@localhost:5432/sumer_reel_forge

# Angular Studio Playwright base URL.
BASE_URL=http://localhost:4200

# Animation Lab Playwright base URL.
ANIMATION_LAB_BASE_URL=http://localhost:4300

# API e2e host.
HOST=localhost
