# NestJS API port.
PORT=3000

# Comma-separated list of frontend origins allowed by API CORS.
WEB_ORIGIN=http://localhost:4200

# Local Docker Postgres connection string from docker-compose.yml.
# Change both values together when another local product already uses 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sumer_reel_forge:sumer_reel_forge@localhost:5432/sumer_reel_forge

# Playwright frontend base URL.
BASE_URL=http://localhost:4200

# API e2e host.
HOST=localhost

# Renderer worker and local artifact settings.
API_BASE_URL=http://localhost:3000/api
RENDER_OUTPUT_ROOT=tmp/renders
RENDER_ADAPTER=mock
RENDER_WORKER_ID=local-renderer
RENDER_HEARTBEAT_INTERVAL_MS=10000
RENDER_JOB_TIMEOUT_MS=900000
RENDER_PROCESS_TIMEOUT_MS=600000
RENDER_POLL_INTERVAL_MS=5000
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=tools/renderer/workflows/storyboard.json
TTS_COMMAND=kokoro
TTS_VOICE=af_heart
TTS_ARGS_JSON=["--text-file","{input}","--output-file","{output}","--voice","{voice}"]
WHISPER_COMMAND=whisper
WHISPER_MODEL=small
WHISPER_ARGS_JSON=["{input}","--model","{model}","--output_dir","{outputDirectory}","--output_format","srt"]
FFMPEG_COMMAND=ffmpeg
