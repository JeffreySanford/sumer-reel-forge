# NestJS API port.
PORT=3000

# Comma-separated list of frontend origins allowed by API CORS.
WEB_ORIGIN=http://localhost:4200

# Local Docker Postgres connection string from docker-compose.yml.
# Change both values together when another local product already uses 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sumer_reel_forge:sumer_reel_forge@localhost:5432/sumer_reel_forge

# Angular Studio Playwright base URL.
BASE_URL=http://localhost:4200

# Animation Lab Playwright base URL.
ANIMATION_LAB_BASE_URL=http://localhost:4300

# API e2e host.
HOST=localhost
E2E_DATABASE_NAME=sumer_reel_forge_e2e
E2E_API_PORT=3100

# Renderer worker and local artifact settings.
API_BASE_URL=http://localhost:3000/api
RENDER_OUTPUT_ROOT=tmp/renders
RENDER_ADAPTER=mock
RENDER_WORKER_ID=local-renderer
RENDER_HEARTBEAT_INTERVAL_MS=10000
RENDER_JOB_TIMEOUT_MS=900000
RENDER_PROCESS_TIMEOUT_MS=600000
RENDER_POLL_INTERVAL_MS=5000

# Managed ComfyUI runtime. Run `pnpm comfyui:setup` once.
# The default setup lives entirely under ignored `.cache/comfyui`.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_DIRECTORY=.cache/comfyui/ComfyUI
COMFYUI_VENV_DIRECTORY=.cache/comfyui/.venv
# Set false when you intentionally want to start/manage ComfyUI yourself.
COMFYUI_MANAGED=true
# Full setup installs/validates the curated models in tools/comfyui/managed-models.json.
# Set false only when you intentionally want a runtime-only ComfyUI installation.
COMFYUI_INSTALL_MODELS=true
# Maximum time allowed for one large model download. Default: 1 hour.
COMFYUI_MODEL_DOWNLOAD_TIMEOUT_MS=3600000
# Optional manifest override for an alternate curated local model set.
# COMFYUI_MANAGED_MODELS_MANIFEST=tools/comfyui/managed-models.json
# Optional stable release override used by `pnpm comfyui:setup`.
# COMFYUI_VERSION=v0.x.y
# Optional PyTorch wheel index override. Current managed NVIDIA default is cu130.
# COMFYUI_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
# Whole-shot image workflow used by the existing local renderer.
COMFYUI_WORKFLOW_PATH=tools/renderer/workflows/storyboard.json
# Dedicated API-format source-image-to-layer workflow for animation-v1 candidates.
# This is intentionally separate from the whole-shot workflow and may reference
# machine-specific checkpoints/custom nodes. See workflows/animation-layer-candidates.md.
# COMFYUI_LAYER_WORKFLOW_PATH=D:/comfy/workflows/srf-animation-layer-api.json
# Optional explicit override; otherwise start:all hardware profiling recommends a value.
# COMFYUI_MAX_PARALLEL=1
TTS_COMMAND=kokoro
TTS_VOICE=af_heart
TTS_ARGS_JSON=["--text-file","{input}","--output-file","{output}","--voice","{voice}"]
WHISPER_COMMAND=whisper
WHISPER_MODEL=small
WHISPER_ARGS_JSON=["{input}","--model","{model}","--output_dir","{outputDirectory}","--output_format","srt"]
FFMPEG_COMMAND=ffmpeg
FFPROBE_COMMAND=ffprobe

# Curated editorial adapter. "auto" uses the voice selected in the studio.
# Chatterbox is the production engine; Kokoro and SAPI remain local fallbacks.
EDITORIAL_ASSET_DIRECTORY=assets/blessings-of-sumer/chapter-01/reel-01/editorial-v1
EDITORIAL_NARRATION_ADAPTER=auto
# Run `pnpm tts:chatterbox:setup` to create this ignored runtime.
CHATTERBOX_COMMAND=.cache/chatterbox/.venv/Scripts/python.exe
CHATTERBOX_UV_COMMAND=uv
CHATTERBOX_VENV_DIRECTORY=.cache/chatterbox/.venv
CHATTERBOX_SCRIPT=tools/chatterbox/synthesize_chatterbox.py
CHATTERBOX_MODEL_DIRECTORY=.cache/chatterbox/model
CHATTERBOX_MODEL_REVISION=5bb1f6ee58e50c3b8d408bc82a6d3740c2db6e18
CHATTERBOX_DEVICE=auto
# Optional: an owned or licensed WAV clip longer than five seconds.
# CHATTERBOX_REFERENCE_AUDIO=.cache/chatterbox/voices/story-narrator.wav
KOKORO_COMMAND=uv
KOKORO_PROJECT_DIRECTORY=tools/tts
KOKORO_SCRIPT=tools/tts/synthesize_kokoro.py
KOKORO_MODEL_PATH=.cache/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=.cache/kokoro/voices-v1.0.bin
KOKORO_VOICE=af_heart
KOKORO_SPEED=0.9
WINDOWS_SPEECH_COMMAND=pwsh.exe
WINDOWS_SPEECH_SCRIPT=tools/scripts/synthesize-windows-speech.ps1
EDITORIAL_VOICE=Microsoft Mark
EDITORIAL_VOICE_RATE=-3
