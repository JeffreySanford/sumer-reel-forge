{
  "name": "@sumer-reel-forge/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "api": "nx serve api",
    "build": "nx run-many -t build",
    "creative:test": "node --test tools/creative/creative-quality.test.mjs",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:prepare:e2e": "node tools/scripts/e2e-api.mjs --prepare-only",
    "db:migrate": "prisma migrate dev",
    "db:prepare": "pnpm db:deploy && pnpm db:seed:chapter1",
    "db:psql": "docker compose exec postgres psql -U sumer_reel_forge -d sumer_reel_forge",
    "db:seed:chapter1": "tsx tools/scripts/seed-chapter-one.ts",
    "db:seed:chapter1:refresh": "tsx tools/scripts/seed-chapter-one.ts --refresh",
    "docker:dev": "docker compose up postgres",
    "e2e": "nx run web:e2e",
    "e2e:ci": "nx run web:e2e-ci",
    "e2e:api": "node tools/scripts/e2e-api.mjs",
    "format": "nx format:write",
    "lint": "pnpm tts:lint && pnpm renderer:lint && nx run-many -t eslint:lint",
    "openapi:types": "openapi-typescript http://localhost:3000/api/docs-json -o libs/reel-core/src/lib/api-contract.ts",
    "planning:ollama:check": "node tools/scripts/check-ollama-planning.mjs",
    "planning:ollama:warm": "node tools/scripts/warm-ollama-planning.mjs",
    "planning:shot3": "node tools/scripts/plan-reel1-shot3.mjs",
    "quality": "pnpm workspace:check && pnpm lint && pnpm test && pnpm build",
    "render:watchdog": "node tools/scripts/render-watchdog.mjs",
    "render:prototype:reel1": "node tools/scripts/render-prototype.mjs",
    "render:editorial:reel1": "node tools/scripts/render-editorial-reel1.mjs",
    "render:animation:proof": "node tools/scripts/render-animation-proof.mjs",
    "render:animation:style-test": "node tools/scripts/render-animation-proof.mjs --scene tools/animation/scenes/cinematic-style-test.scene.json --composition CinematicStyleTest --prefix cinematic-style-test --manifest cinematic-style-test-manifest.json",
    "render:animation:style-review": "node tools/scripts/render-animation-style-review.mjs",
    "render:animation:style-review:studio": "node tools/scripts/persist-animation-style-review.mjs",
    "render:animation:motion-proof": "node tools/scripts/render-animation-proof.mjs --scene tools/animation/scenes/cinematic-motion-proof.scene.json --composition CinematicMotionProof --prefix cinematic-motion-proof --manifest cinematic-motion-proof-manifest.json",
    "render:animation:motion-review": "node tools/scripts/render-animation-style-review.mjs --scene tools/animation/scenes/cinematic-motion-proof.scene.json --composition CinematicMotionProof --prefix cinematic-motion-proof --reviewType cinematic-animation-motion-proof --title \"Cinematic Animation Motion Proof Review\" --frames 3,9,15 --outputDirectory tmp/renders/animation-motion-review",
    "render:animation:shot3-benchmark": "tsx tools/scripts/render-scene-v2-benchmark.ts",
    "render:animation:shot4-benchmark": "tsx tools/scripts/render-scene-v2-benchmark.ts tools/animation/scenes/reel-01-shot-04-nammu-benchmark.scene-v2.json",
    "render:animation:full-reel1": "node tools/scripts/render-animation-proof.mjs --scene tools/animation/scenes/reel-01-full-animation.scene.json --composition FullReelAnimation --prefix reel-animation-v1 --manifest animation-reel1-manifest.json --adapter animation --narration-adapter chatterbox",
    "render:animation:reel1": "node tools/scripts/render-animation-reel1.mjs",
    "render:final:reel1": "node tools/scripts/render-editorial-reel1.mjs --final",
    "renderer:worker": "node tools/scripts/renderer-worker.mjs",
    "renderer:preflight": "node tools/scripts/renderer-preflight.mjs",
    "renderer:lint": "eslint \"tools/**/*.mjs\"",
    "renderer:test": "node --test tools/renderer/*.test.mjs",
    "scene-v2:test": "tsx --test tools/animation/src/scene-v2.test.ts",
    "tts:chatterbox:setup": "node tools/scripts/setup-chatterbox.mjs",
    "tts:kokoro:setup": "node tools/scripts/setup-kokoro.mjs",
    "tts:kokoro:audition": "node tools/scripts/audition-kokoro.mjs",
    "tts:lint": "uv run --project tools/tts --locked ruff check tools/tts tools/chatterbox",
    "tts:test": "uv run --project tools/tts --locked python -m unittest discover -s tools/tts -p test_*.py && uv run --project tools/tts --locked python -m unittest discover -s tools/chatterbox -p test_*.py",
    "start:all": "node tools/scripts/start-local.mjs",
    "start:core": "node tools/scripts/start-all.mjs",
    "storybook": "nx storybook web",
    "security:audit": "pnpm audit --prod --audit-level high",
    "storybook:build": "nx build-storybook web",
    "test": "pnpm workspace:check && pnpm creative:test && pnpm scene-v2:test && pnpm tts:test && pnpm renderer:test && nx run-many -t test",
    "web": "nx serve web",
    "workspace:check": "node tools/scripts/check-workspace-consistency.mjs"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.4",
    "@angular-devkit/core": "^22.1.4",
    "@angular-devkit/schematics": "^22.1.4",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "23.1.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/storybook": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@playwright/test": "^1.62.1",
    "@remotion/cli": "4.0.515",
    "@remotion/renderer": "4.0.515",
    "@schematics/angular": "^22.1.4",
    "@storybook/angular": "^10.5.9",
    "@storybook/test-runner": "^0.24.4",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "~4.1.0",
    "angular-eslint": "^22.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "~3.6.2",
    "prisma": "^7.9.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "storybook": "^10.5.0",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@angular/common": "~22.1.2",
    "@angular/compiler": "~22.1.2",
    "@angular/core": "~22.1.2",
    "@angular/forms": "~22.1.2",
    "@angular/platform-browser": "~22.1.2",
    "@angular/router": "~22.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "~7.8.0",
    "swagger-ui-express": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "deepmerge-ts": "8.0.1",
      "less>image-size": "-",
      "uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "esbuild",
      "nx",
      "prisma"
    ]
  }
}
