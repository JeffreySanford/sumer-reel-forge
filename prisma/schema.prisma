generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model StudioProject {
  id                      String                 @id @default(uuid()) @db.Uuid
  slug                    String                 @unique
  title                   String
  description             String?
  defaultNarrationVoiceId String?                @map("default_narration_voice_id") @db.Uuid
  narrationStylePreset    NarrationStylePreset   @default(MYTHIC) @map("narration_style_preset")
  narrationStyleNotes     String?                @map("narration_style_notes")
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  sourceDocuments         SourceDocument[]
  defaultNarrationVoice   NarrationVoiceProfile? @relation("ProjectDefaultNarrationVoice", fields: [defaultNarrationVoiceId], references: [id], onDelete: SetNull)

  @@map("studio_projects")
}

model SourceDocument {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @map("project_id") @db.Uuid
  title     String
  sourceRef String?       @map("source_ref")
  status    DocumentState @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  chapters  Chapter[]
  project   StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("source_documents")
}

model Chapter {
  id                       String                 @id @default(uuid()) @db.Uuid
  sourceDocumentId         String                 @map("source_document_id") @db.Uuid
  chapterNumber            Int                    @map("chapter_number")
  title                    String
  synopsis                 String?
  narrationOverrideEnabled Boolean                @default(false) @map("narration_override_enabled")
  narrationVoiceId         String?                @map("narration_voice_id") @db.Uuid
  narrationStylePreset     NarrationStylePreset?  @map("narration_style_preset")
  narrationStyleNotes      String?                @map("narration_style_notes")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  document                 SourceDocument         @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  narrationVoice           NarrationVoiceProfile? @relation("ChapterNarrationVoice", fields: [narrationVoiceId], references: [id], onDelete: SetNull)
  narrationRoles           ChapterNarrationRole[]
  reels                    Reel[]

  @@unique([sourceDocumentId, chapterNumber])
  @@map("chapters")
}

model NarrationVoiceProfile {
  id                     String                 @id @default(uuid()) @db.Uuid
  slug                   String                 @unique
  displayName            String                 @map("display_name")
  description            String?
  engine                 NarrationEngine
  model                  String
  language               String                 @default("en")
  providerVoice          String?                @map("provider_voice")
  referenceAudioUri      String?                @map("reference_audio_uri")
  referenceAudioChecksum String?                @map("reference_audio_checksum")
  rightsBasis            String?                @map("rights_basis")
  rightsConfirmedAt      DateTime?              @map("rights_confirmed_at") @db.Timestamptz(6)
  defaultExaggeration    Float                  @default(0.5) @map("default_exaggeration")
  defaultCfgWeight       Float                  @default(0.5) @map("default_cfg_weight")
  defaultTemperature     Float                  @default(0.8) @map("default_temperature")
  active                 Boolean                @default(true)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  projectDefaults        StudioProject[]        @relation("ProjectDefaultNarrationVoice")
  chapterOverrides       Chapter[]              @relation("ChapterNarrationVoice")
  chapterRoles           ChapterNarrationRole[]

  @@index([active, engine])
  @@map("narration_voice_profiles")
}

model ChapterNarrationRole {
  id             String                 @id @default(uuid()) @db.Uuid
  chapterId      String                 @map("chapter_id") @db.Uuid
  roleKey        String                 @map("role_key")
  displayName    String                 @map("display_name")
  roleType       NarrationRoleType      @map("role_type")
  voiceProfileId String?                @map("voice_profile_id") @db.Uuid
  stylePreset    NarrationStylePreset?  @map("style_preset")
  styleNotes     String?                @map("style_notes")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  chapter        Chapter                @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  voiceProfile   NarrationVoiceProfile? @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)

  @@unique([chapterId, roleKey])
  @@index([voiceProfileId])
  @@map("chapter_narration_roles")
}

model Reel {
  id                    String               @id @default(uuid()) @db.Uuid
  chapterId             String               @map("chapter_id") @db.Uuid
  episodeNumber         Int                  @map("episode_number")
  title                 String
  sourceSection         String               @map("source_section")
  hook                  String
  visualCore            String               @map("visual_core")
  logline               String?
  narration             String?
  targetDurationSeconds Int                  @default(60) @map("target_duration_seconds")
  musicDirection        String?              @map("music_direction")
  voiceDirection        String?              @map("voice_direction")
  platformNotes         String[]             @default([]) @map("platform_notes")
  onScreenText          Json                 @default("[]") @map("on_screen_text")
  exportMetadata        Json                 @default("{}") @map("export_metadata")
  productionStatus      ReelProductionStatus @default(DRAFT) @map("production_status")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  chapter               Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  shots                 ReelShot[]
  renderJobs            RenderJob[]
  planningRuns          PlanningRun[]

  @@unique([chapterId, episodeNumber])
  @@map("reels")
}

model ReelShot {
  id              String   @id @default(uuid()) @db.Uuid
  reelId          String   @map("reel_id") @db.Uuid
  shotNumber      Int      @map("shot_number")
  timecode        String
  durationSeconds Int      @map("duration_seconds")
  visual          String
  motion          String
  prompt          String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  reel            Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([reelId, shotNumber])
  @@map("reel_shots")
}

model PlanningRun {
  id              String            @id @default(uuid()) @db.Uuid
  reelId          String            @map("reel_id") @db.Uuid
  shotNumber      Int               @map("shot_number")
  shotKey         String            @map("shot_key")
  provider        String
  model           String?
  promptVersion   String            @default("shot-plan-v1") @map("prompt_version")
  status          PlanningRunStatus @default(PROPOSAL_READY)
  inputHash       String            @map("input_hash")
  outputHash      String            @map("output_hash")
  workingHash     String            @map("working_hash")
  input           Json
  proposal        Json
  workingProposal Json              @map("working_proposal")
  durationMs      Int?              @map("duration_ms")
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy      String?           @map("reviewed_by")
  reviewNotes     String?           @map("review_notes")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  reel            Reel              @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([reelId, shotNumber, createdAt])
  @@index([status, createdAt])
  @@map("planning_runs")
}

model GeneratedAsset {
  id           String            @id @default(uuid()) @db.Uuid
  renderJobId  String?           @map("render_job_id") @db.Uuid
  shotNumber   Int?              @map("shot_number")
  assetType    String            @map("asset_type")
  uri          String
  checksum     String?
  metadata     Json              @default("{}")
  reviewStatus AssetReviewStatus @default(PENDING) @map("review_status")
  reviewNotes  String?           @map("review_notes")
  reviewedAt   DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy   String?           @map("reviewed_by")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  renderJob    RenderJob?        @relation(fields: [renderJobId], references: [id], onDelete: SetNull)

  @@index([renderJobId, shotNumber])
  @@index([reviewStatus])
  @@map("generated_assets")
}

model RenderJob {
  id              String             @id @default(uuid()) @db.Uuid
  reelId          String             @map("reel_id") @db.Uuid
  episodeId       Int                @map("episode_id")
  mode            RenderJobMode
  pipeline        RenderPipeline?
  status          RenderJobStatus    @default(QUEUED)
  voice           String?
  narrationConfig Json               @default("{}") @map("narration_config")
  notes           String?
  workerId        String?            @map("worker_id")
  attemptCount    Int                @default(0) @map("attempt_count")
  startedAt       DateTime?          @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?          @map("finished_at") @db.Timestamptz(6)
  heartbeatAt     DateTime?          @map("heartbeat_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  reel            Reel               @relation(fields: [reelId], references: [id], onDelete: Cascade)
  assets          GeneratedAsset[]
  attempts        RenderJobAttempt[]
  logs            RenderJobLog[]

  @@index([status, heartbeatAt])
  @@index([status, pipeline, createdAt])
  @@map("render_jobs")
}

model RenderJobAttempt {
  id            String          @id @default(uuid()) @db.Uuid
  renderJobId   String          @map("render_job_id") @db.Uuid
  attemptNumber Int             @map("attempt_number")
  workerId      String          @map("worker_id")
  status        RenderJobStatus @default(RUNNING)
  startedAt     DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  heartbeatAt   DateTime?       @map("heartbeat_at") @db.Timestamptz(6)
  finishedAt    DateTime?       @map("finished_at") @db.Timestamptz(6)
  error         String?
  renderJob     RenderJob       @relation(fields: [renderJobId], references: [id], onDelete: Cascade)

  @@unique([renderJobId, attemptNumber])
  @@index([status, heartbeatAt])
  @@map("render_job_attempts")
}

model RenderJobLog {
  id          String          @id @default(uuid()) @db.Uuid
  renderJobId String          @map("render_job_id") @db.Uuid
  workerId    String?         @map("worker_id")
  level       RenderLogLevel  @default(INFO)
  stream      RenderLogStream @default(SYSTEM)
  message     String
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  renderJob   RenderJob       @relation(fields: [renderJobId], references: [id], onDelete: Cascade)

  @@index([renderJobId, createdAt])
  @@map("render_job_logs")
}

model AnimationJob {
  id           String                @id @default(uuid()) @db.Uuid
  shotNumber   Int                   @map("shot_number")
  layerId      String?               @map("layer_id")
  operation    AnimationJobOperation
  status       RenderJobStatus       @default(QUEUED)
  notes        String?
  workerId     String?               @map("worker_id")
  attemptCount Int                   @default(0) @map("attempt_count")
  startedAt    DateTime?             @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?             @map("finished_at") @db.Timestamptz(6)
  heartbeatAt  DateTime?             @map("heartbeat_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  attempts     AnimationJobAttempt[]
  logs         AnimationJobLog[]

  @@index([status, heartbeatAt])
  @@index([status, createdAt])
  @@map("animation_jobs")
}

model AnimationJobAttempt {
  id             String          @id @default(uuid()) @db.Uuid
  animationJobId String          @map("animation_job_id") @db.Uuid
  attemptNumber  Int             @map("attempt_number")
  workerId       String          @map("worker_id")
  status         RenderJobStatus @default(RUNNING)
  startedAt      DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  heartbeatAt    DateTime?       @map("heartbeat_at") @db.Timestamptz(6)
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz(6)
  error          String?
  animationJob   AnimationJob    @relation(fields: [animationJobId], references: [id], onDelete: Cascade)

  @@unique([animationJobId, attemptNumber])
  @@index([status, heartbeatAt])
  @@map("animation_job_attempts")
}

model AnimationJobLog {
  id             String          @id @default(uuid()) @db.Uuid
  animationJobId String          @map("animation_job_id") @db.Uuid
  workerId       String?         @map("worker_id")
  level          RenderLogLevel  @default(INFO)
  stream         RenderLogStream @default(SYSTEM)
  message        String
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  animationJob   AnimationJob    @relation(fields: [animationJobId], references: [id], onDelete: Cascade)

  @@index([animationJobId, createdAt])
  @@map("animation_job_logs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  summary    Json     @default("{}")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum DocumentState {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED

  @@map("document_state")
}

enum RenderJobMode {
  STORYBOARD
  DRAFT_VIDEO
  FINAL_VIDEO

  @@map("render_job_mode")
}

enum RenderPipeline {
  MOCK
  LOCAL
  EDITORIAL
  ANIMATION

  @@map("render_pipeline")
}

enum RenderJobStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED

  @@map("render_job_status")
}

enum AnimationJobOperation {
  PLAN
  PREFLIGHT
  GENERATE
  VERIFY
  RUN
  CANDIDATES

  @@map("animation_job_operation")
}

enum ReelProductionStatus {
  DRAFT
  REVIEW
  APPROVED
  RENDERING
  PUBLISHED

  @@map("reel_production_status")
}

enum PlanningRunStatus {
  PROPOSAL_READY
  APPROVED
  REJECTED
  SUPERSEDED
  FAILED

  @@map("planning_run_status")
}

enum AssetReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("asset_review_status")
}

enum RenderLogLevel {
  INFO
  WARN
  ERROR

  @@map("render_log_level")
}

enum RenderLogStream {
  STDOUT
  STDERR
  SYSTEM

  @@map("render_log_stream")
}

enum NarrationEngine {
  CHATTERBOX
  KOKORO

  @@map("narration_engine")
}

enum NarrationStylePreset {
  DOCUMENTARY
  INTIMATE
  MYTHIC
  DRAMATIC
  ARCHIVAL

  @@map("narration_style_preset")
}

enum NarrationRoleType {
  NARRATOR
  CHARACTER
  ARCHIVAL
  CHORUS

  @@map("narration_role_type")
}
