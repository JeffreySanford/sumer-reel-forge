{
  "schemaVersion": 2,
  "registryId": "animation-production-lanes-v1",
  "lanes": [
    {
      "id": "exact-source-preservation",
      "match": { "role": "background", "material": "underwater-refraction", "hasAlpha": false },
      "generator": {
        "family": "source-preservation",
        "executor": "tools/scripts/source-preservation-layer.mjs"
      },
      "qa": {
        "family": "checksum-identity",
        "executor": "tools/scripts/source-preservation-layer.mjs",
        "humanReviewRequired": true
      },
      "notes": [
        "Use when the editorial background itself is the stillness anchor.",
        "No synthesis, crop, resize, or pixel mutation is allowed."
      ]
    },
    {
      "id": "stable-architecture-preservation",
      "match": { "role": "background", "material": "architectural-background", "hasAlpha": false },
      "generator": {
        "family": "source-preservation",
        "executor": "tools/scripts/source-preservation-layer.mjs"
      },
      "qa": {
        "family": "checksum-identity",
        "executor": "tools/scripts/source-preservation-layer.mjs",
        "humanReviewRequired": true
      },
      "notes": [
        "Use when architecture or a shrine structure is the compositional stillness anchor.",
        "Preserve the exact editorial plate; depth and motion come from registered overlays and camera composition rather than rebuilding the structure.",
        "No synthesis, crop, resize, or pixel mutation is allowed in the preserved base."
      ]
    },
    {
      "id": "semantic-water-overlay",
      "match": { "role": "water", "material": "water", "hasAlpha": true },
      "generator": {
        "family": "sam3-semantic-overlay",
        "workflowPath": "tools/renderer/workflows/semantic-overlay-sam3-api.json"
      },
      "qa": {
        "family": "alpha-structure-then-composite-motion",
        "executor": "tools/scripts/verify-semantic-overlay-candidate.mjs",
        "alphaCoverage": { "minimum": 0.001, "preferredMinimum": 0.005, "maximum": 0.9 },
        "requireSourceRgbUnderAlpha": true,
        "humanReviewRequired": true
      },
      "notes": [
        "Preserve source RGB under alpha.",
        "The minimum alpha coverage is a hard trivial-mask floor, not an artistic target; sparse underwater flow may be valid below preferredMinimum.",
        "Reject whole-frame selection and character-shaped water masks.",
        "Production motion should occur within the material rather than as a translated card.",
        "Per-layer structural QA precedes motion QA in the assembled shot benchmark."
      ]
    },
    {
      "id": "semantic-smoke-overlay",
      "state": "provisional",
      "match": { "role": "atmosphere", "material": "smoke", "hasAlpha": true },
      "generator": {
        "family": "sam3-semantic-overlay",
        "workflowPath": "tools/renderer/workflows/semantic-overlay-sam3-api.json"
      },
      "qa": {
        "family": "alpha-structure-then-composite-motion",
        "executor": "tools/scripts/verify-semantic-overlay-candidate.mjs",
        "alphaCoverage": { "minimum": 0.00025, "preferredMinimum": 0.0015, "maximum": 0.3 },
        "requireSourceRgbUnderAlpha": true,
        "humanReviewRequired": true
      },
      "notes": [
        "PROVISIONAL: Shot 5 must validate this lane before it becomes reusable production knowledge.",
        "Prefer source-supported smoke or hearth haze; do not invent a new plume or obscure the hospitality eye target.",
        "Soft/sparse coverage is expected, so the minimum is only a hard non-triviality floor.",
        "Motion should be low-opacity, irregular, rising/lateral internal drift rather than translating the extracted PNG as one card.",
        "Human review must reject masks that mostly select architecture, faces, fire, or broad background haze instead of smoke."
      ]
    },
    {
      "id": "semantic-refraction-overlay",
      "match": { "role": "reflection", "material": "underwater-refraction", "hasAlpha": true },
      "generator": {
        "family": "sam3-semantic-overlay",
        "workflowPath": "tools/renderer/workflows/semantic-overlay-sam3-api.json"
      },
      "qa": {
        "family": "alpha-structure-then-composite-motion",
        "executor": "tools/scripts/verify-semantic-overlay-candidate.mjs",
        "alphaCoverage": { "minimum": 0.0005, "preferredMinimum": 0.002, "maximum": 0.65 },
        "requireSourceRgbUnderAlpha": true,
        "humanReviewRequired": true
      },
      "notes": [
        "Prefer upper/surface refraction structures supported by the editorial source.",
        "The minimum alpha coverage is a hard trivial-mask floor; sparse highlights/refraction bands can be valid below preferredMinimum when semantically correct.",
        "No new light source or fantasy glow.",
        "Per-layer structural QA precedes motion QA in the assembled shot benchmark."
      ]
    },
    {
      "id": "environmental-coherence-mask",
      "match": { "role": "mask", "material": "divine-light", "hasAlpha": true },
      "generator": {
        "family": "semantic-coherence-mask",
        "workflowPath": "tools/renderer/workflows/semantic-overlay-sam3-api.json"
      },
      "qa": {
        "family": "mask-shape-and-reveal",
        "executor": "tools/scripts/verify-semantic-overlay-candidate.mjs",
        "alphaCoverage": { "minimum": 0.00025, "preferredMinimum": 0.001, "maximum": 0.4 },
        "requireSourceRgbUnderAlpha": true,
        "humanReviewRequired": true
      },
      "notes": [
        "Mask follows source-supported water/light structure.",
        "The minimum alpha coverage is only a hard non-triviality floor; a sparse coherence structure is acceptable when the human review confirms the intended environmental read.",
        "Never resolve to a hard character silhouette, face cutout, mermaid, aura, or glowing eyes.",
        "Automated alpha coverage can reject trivial/whole-frame masks but human review owns semantic shape judgment."
      ]
    },
    {
      "id": "masked-background-repair",
      "match": { "role": "background", "material": "atmosphere-distant", "hasAlpha": false },
      "generator": { "family": "masked-inpainting", "executionMode": "dependency-aware-dedicated" },
      "qa": {
        "family": "outside-preservation-plus-inside-reconstruction",
        "humanReviewRequired": true
      },
      "notes": [
        "Build the removal mask from the exact reviewed foreground candidates.",
        "Outside-mask editorial pixels must remain unchanged.",
        "Dependency-aware repair remains a dedicated lane until foreground dependency resolution is generalized."
      ]
    },
    {
      "id": "rigid-prop-extraction",
      "match": { "role": "major-prop", "material": "rigid-vessel", "hasAlpha": true },
      "generator": {
        "family": "sam3-semantic-overlay",
        "workflowPath": "tools/renderer/workflows/semantic-overlay-sam3-api.json"
      },
      "qa": {
        "family": "alpha-structure-then-composite-motion",
        "executor": "tools/scripts/verify-semantic-overlay-candidate.mjs",
        "alphaCoverage": { "minimum": 0.002, "maximum": 0.65 },
        "requireSourceRgbUnderAlpha": true,
        "humanReviewRequired": true
      },
      "notes": [
        "Preserve exact silhouette/material detail.",
        "Use low-frequency rigid-body motion; never deform the prop."
      ]
    },
    {
      "id": "character-source-extraction",
      "match": { "role": "character", "hasAlpha": true },
      "generator": {
        "family": "sam3-semantic-overlay",
        "workflowPath": "tools/renderer/workflows/semantic-overlay-sam3-api.json"
      },
      "qa": {
        "family": "identity-alpha-then-composite-motion",
        "executor": "tools/scripts/verify-semantic-overlay-candidate.mjs",
        "alphaCoverage": { "minimum": 0.001, "maximum": 0.65 },
        "requireSourceRgbUnderAlpha": true,
        "humanReviewRequired": true
      },
      "notes": [
        "Preserve face, hands, costume, lighting, silhouette, and painterly identity.",
        "Motion QA never substitutes for human identity review."
      ]
    },
    {
      "id": "foreground-source-extraction",
      "match": { "role": "foreground-occluder", "hasAlpha": true },
      "generator": {
        "family": "sam3-semantic-overlay",
        "workflowPath": "tools/renderer/workflows/semantic-overlay-sam3-api.json"
      },
      "qa": {
        "family": "alpha-structure-plus-safe-zone-review",
        "executor": "tools/scripts/verify-semantic-overlay-candidate.mjs",
        "alphaCoverage": { "minimum": 0.001, "maximum": 0.5 },
        "requireSourceRgbUnderAlpha": true,
        "humanReviewRequired": true
      },
      "notes": [
        "Foreground must remain subordinate and must avoid face/caption safe zones."
      ]
    },
    {
      "id": "procedural-light-overlay",
      "match": { "role": "light", "hasAlpha": true },
      "generator": { "family": "procedural-or-source-derived-light", "executionMode": "human-designed" },
      "qa": { "family": "source-consistency-and-reveal", "humanReviewRequired": true },
      "notes": [
        "No hard aura, glowing eyes, or particle halo.",
        "Use only subtle source-supported illumination."
      ]
    }
  ]
}
