{
  "1": {
    "inputs": {
      "image": "{{SOURCE_IMAGE}}"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Approved Shot 3 editorial source"
    }
  },
  "2": {
    "inputs": {
      "image": "{{AUXILIARY_IMAGE}}"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Validated Enki + vessel removal mask"
    }
  },
  "3": {
    "inputs": {
      "image": [
        "2",
        0
      ],
      "channel": "red"
    },
    "class_type": "ImageToMask",
    "_meta": {
      "title": "Convert removal image to inpaint mask"
    }
  },
  "4": {
    "inputs": {
      "ckpt_name": "sd-v1-5-inpainting.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Stable Diffusion 1.5 inpainting"
    }
  },
  "5": {
    "inputs": {
      "text": "conservative continuation of the existing painted ancient river environment, water, sky, distant landscape, natural atmospheric continuity, preserve the supplied palette, lighting, brushwork, perspective and historical visual language. Fill only the removed foreground regions with plausible background already implied by adjacent pixels. {{LAYER_PROMPT}}",
      "clip": [
        "4",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Background continuation prompt"
    }
  },
  "6": {
    "inputs": {
      "text": "person, man, human figure, face, body, robe, boat, vessel, ship, mast, new object, new composition, changed palette, changed lighting, text, watermark, logo, fantasy redesign, modern object. {{NEGATIVE_PROMPT}}",
      "clip": [
        "4",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Reject foreground subject regeneration"
    }
  },
  "7": {
    "inputs": {
      "pixels": [
        "1",
        0
      ],
      "vae": [
        "4",
        2
      ],
      "mask": [
        "3",
        0
      ],
      "grow_mask_by": 12
    },
    "class_type": "VAEEncodeForInpaint",
    "_meta": {
      "title": "Encode only masked background vacancies"
    }
  },
  "8": {
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 28,
      "cfg": 5.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": [
        "4",
        0
      ],
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "latent_image": [
        "7",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "Conservative masked inpaint"
    }
  },
  "9": {
    "inputs": {
      "samples": [
        "8",
        0
      ],
      "vae": [
        "4",
        2
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode reconstructed background"
    }
  },
  "10": {
    "inputs": {
      "destination": [
        "1",
        0
      ],
      "source": [
        "9",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "3",
        0
      ]
    },
    "class_type": "ImageCompositeMasked",
    "_meta": {
      "title": "Restore untouched editorial pixels outside removal mask"
    }
  },
  "11": {
    "inputs": {
      "filename_prefix": "{{OUTPUT_PREFIX}}",
      "images": [
        "10",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save full-canvas background candidate"
    }
  }
}
