{
  "schemaVersion": 1,
  "libraryId": "blessings-of-sumer-animation-style-decisions-v1",
  "principle": "AI proposes. Rules constrain. Human directs.",
  "decisions": [
    {
      "id": "project-editorial-source-immutable",
      "state": "approved",
      "scope": { "type": "project", "projectSlug": "blessings-of-sumer" },
      "path": "source.editorialMutationAllowed",
      "value": false,
      "rationale": "Approved editorial artwork is the visual authority and must never be overwritten by candidate generation or promotion.",
      "source": { "type": "workflow-rule", "reference": "animation-v1 candidate lifecycle" }
    },
    {
      "id": "project-human-approval-final-gate",
      "state": "approved",
      "scope": { "type": "project", "projectSlug": "blessings-of-sumer" },
      "path": "review.humanApprovalRequired",
      "value": true,
      "rationale": "Technical QA can reject candidates but cannot approve artistic publication quality.",
      "source": { "type": "workflow-rule", "reference": "Shot 3 promotion gate" }
    },
    {
      "id": "project-candidates-never-auto-promote",
      "state": "approved",
      "scope": { "type": "project", "projectSlug": "blessings-of-sumer" },
      "path": "assetLifecycle.automaticPromotionAllowed",
      "value": false,
      "rationale": "Generation and review must remain separated from canonical animation-v1 mutation.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm" }
    },
    {
      "id": "project-preserve-editorial-asset-resolution",
      "state": "approved",
      "scope": { "type": "project", "projectSlug": "blessings-of-sumer" },
      "path": "assets.preserveEditorialResolution",
      "value": true,
      "rationale": "Layer assets stay registered at source editorial resolution; the render canvas is a separate presentation concern.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm" }
    },
    {
      "id": "project-render-canvas-independent",
      "state": "approved",
      "scope": { "type": "reel", "projectSlug": "blessings-of-sumer", "chapterNumber": 1, "episodeNumber": 1 },
      "path": "render.canvas",
      "value": { "width": 1080, "height": 1920, "fps": 30 },
      "rationale": "Native editorial assets are composed onto the vertical output canvas at render time rather than resized during asset production.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm" }
    },
    {
      "id": "project-checksum-provenance-required",
      "state": "approved",
      "scope": { "type": "project", "projectSlug": "blessings-of-sumer" },
      "path": "promotion.requireChecksumProvenance",
      "value": true,
      "rationale": "Promotion must prove that the reviewed candidate is the exact file entering animation-v1.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm" }
    },
    {
      "id": "project-extraction-source-pixels-authoritative",
      "state": "approved",
      "scope": { "type": "project", "projectSlug": "blessings-of-sumer" },
      "path": "extraction.sourcePixelsAuthoritative",
      "value": true,
      "rationale": "Semantic extraction lanes preserve source RGB and use alpha to isolate material instead of redrawing the approved art.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm" }
    },
    {
      "id": "background-repair-mask-only",
      "state": "approved",
      "scope": { "type": "role", "role": "background" },
      "path": "backgroundRepair.inpaintOnlyRemovalMask",
      "value": true,
      "rationale": "When foreground removal requires synthesis, generated pixels are restricted to the removal region and untouched editorial pixels are restored exactly outside it.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm", "layerId": "shot03-background-v1" }
    },
    {
      "id": "background-repair-outside-preservation",
      "state": "approved",
      "scope": { "type": "role", "role": "background" },
      "path": "qa.background.outsideMaskChangedPixelsMaximum",
      "value": 0,
      "rationale": "Shot 3 demonstrated exact outside-mask preservation as a practical deterministic QA gate.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm", "layerId": "shot03-background-v1" }
    },
    {
      "id": "water-motion-material-internal",
      "state": "approved",
      "scope": { "type": "material", "material": "water" },
      "path": "motion.water.strategy",
      "value": "multi-frequency-material-internal",
      "rationale": "Production water should read as refraction/current/highlight motion within the material rather than translating a whole PNG like a card.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm", "layerId": "shot03-water-v1" }
    },
    {
      "id": "water-approved-motion-presets",
      "state": "approved",
      "scope": { "type": "material", "material": "water" },
      "path": "motion.presets",
      "value": ["waterPulse"],
      "rationale": "Shot 3 human approval established waterPulse as the baseline material preset for source-derived water overlays; later benchmarks may extend this list rather than replace the material-internal motion rule.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm", "layerId": "shot03-water-v1" }
    },
    {
      "id": "rigid-vessel-heavy-physical",
      "state": "approved",
      "scope": { "type": "material", "material": "rigid-vessel" },
      "path": "motion.primaryPreset",
      "value": "heavyPhysical",
      "rationale": "Large rigid vessels use restrained low-frequency inertia rather than elastic or puppet-like deformation.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm", "layerId": "shot03-vessel-v1" }
    },
    {
      "id": "rigid-vessel-approved-motion-presets",
      "state": "approved",
      "scope": { "type": "material", "material": "rigid-vessel" },
      "path": "motion.presets",
      "value": ["heavyPhysical"],
      "rationale": "Shot 3 human approval confirms the manifest-level preset association for rigid vessel layers.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm", "layerId": "shot03-vessel-v1" }
    },
    {
      "id": "cloth-heavy-approved-motion-presets",
      "state": "approved",
      "scope": { "type": "material", "material": "cloth-heavy" },
      "path": "motion.presets",
      "value": ["breathing"],
      "rationale": "Shot 3 human approval confirms restrained breathing as the baseline micro-performance preset for the source-derived cloth-heavy Enki layer; parent inertia remains shot-context dependent.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm", "layerId": "shot03-enki-body-v1" }
    },
    {
      "id": "atmosphere-distant-approved-motion-presets",
      "state": "approved",
      "scope": { "type": "material", "material": "atmosphere-distant" },
      "path": "motion.presets",
      "value": ["cinematicSlow"],
      "rationale": "Shot 3 human approval confirms cinematicSlow as the baseline preset association for the repaired distant background plate.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm", "layerId": "shot03-background-v1" }
    },
    {
      "id": "shot3-approved-stillness-anchor",
      "state": "approved",
      "scope": { "type": "shot", "shotId": "enki-at-the-helm" },
      "path": "composition.stillnessAnchor",
      "value": "enki-facial-identity",
      "rationale": "The approved physical benchmark keeps Enki facial identity as the compositional stillness anchor while environmental and vessel motion occur around it.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm" }
    },
    {
      "id": "character-on-vessel-shares-parent-inertia",
      "state": "approved",
      "scope": { "type": "shot", "shotId": "enki-at-the-helm" },
      "path": "characterMotion.parentInertia",
      "value": "vessel",
      "rationale": "Enki remains physically planted by sharing vessel inertia; only micro-performance is layered on top.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm", "layerId": "shot03-enki-body-v1" }
    },
    {
      "id": "enki-identity-is-stillness-anchor",
      "state": "approved",
      "scope": { "type": "character", "character": "enki" },
      "path": "character.identityDeformationAllowed",
      "value": false,
      "rationale": "Breathing and inertia may move the registered body layer, but facial identity, beard, hands, costume, lighting, and silhouette must remain source-consistent.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm", "layerId": "shot03-enki-body-v1" }
    },
    {
      "id": "foreground-avoids-face-and-captions",
      "state": "approved",
      "scope": { "type": "role", "role": "foreground-occluder" },
      "path": "occlusion.mustAvoid",
      "value": ["face", "captions"],
      "rationale": "Foreground depth cues remain subordinate to identity and reading channels.",
      "source": { "type": "approved-benchmark", "shotId": "enki-at-the-helm" }
    },
    {
      "id": "nammu-near-static-camera",
      "state": "provisional",
      "scope": { "type": "shot", "shotId": "nammu-under-water" },
      "path": "camera.maxScaleDelta",
      "value": 0.01,
      "rationale": "Nammu's recognition should emerge from environmental change rather than camera emphasis.",
      "source": { "type": "creative-policy", "reference": "reel-01-quality-policy.json" }
    },
    {
      "id": "nammu-environmental-coherence",
      "state": "provisional",
      "scope": { "type": "shot", "shotId": "nammu-under-water" },
      "path": "reveal.mode",
      "value": "environmental-coherence",
      "rationale": "Nammu should become recognizable within water, refraction, negative space, and light rather than enter as a conventional character layer.",
      "source": { "type": "creative-policy", "reference": "reel-01-quality-policy.json" }
    },
    {
      "id": "nammu-forbid-generic-fantasy-apparition",
      "state": "provisional",
      "scope": { "type": "shot", "shotId": "nammu-under-water" },
      "path": "reveal.forbiddenTreatments",
      "value": ["literal-character-fade", "mermaid", "glowing-eyes", "horror-stinger", "particle-explosion", "hard-aura"],
      "rationale": "The scene should remain numinous and source-grounded rather than collapse into generic fantasy VFX language.",
      "source": { "type": "creative-policy", "reference": "reel-01-quality-policy.json" }
    },
    {
      "id": "nammu-deep-water-source-anchor",
      "state": "provisional",
      "scope": { "type": "layer", "layerId": "shot04-deep-water-v1" },
      "path": "generation.strategy",
      "value": "exact-editorial-source-copy",
      "rationale": "The deep-water base acts as the immutable visual anchor; environmental life is layered above it rather than synthesized into the base.",
      "source": { "type": "shot4-benchmark-plan", "shotId": "nammu-under-water" }
    },
    {
      "id": "shot5-stable-documentary-camera",
      "state": "provisional",
      "scope": { "type": "shot", "shotId": "traveler-shrine-hospitality" },
      "path": "camera.primaryPreset",
      "value": "slowPush",
      "rationale": "The Traveler Shrine should feel observed rather than staged: a restrained push creates depth while keeping the hospitality action practical and legible.",
      "source": { "type": "creative-policy", "reference": "planning/reel-01-cinematic-direction-plan.md" }
    },
    {
      "id": "shot5-shrine-structure-stillness-anchor",
      "state": "provisional",
      "scope": { "type": "shot", "shotId": "traveler-shrine-hospitality" },
      "path": "composition.stillnessAnchor",
      "value": "shrine-structure",
      "rationale": "Architecture remains stable while water, smoke, cloth, and small human motion communicate lived hospitality around it.",
      "source": { "type": "creative-policy", "reference": "planning/reel-01-cinematic-direction-plan.md" }
    },
    {
      "id": "shot5-practical-hospitality-not-tableau",
      "state": "provisional",
      "scope": { "type": "shot", "shotId": "traveler-shrine-hospitality" },
      "path": "composition.requiredRead",
      "value": "lived-in-practical-hospitality",
      "rationale": "Water basin, bread, shelter, lamps, smoke, cloth, and evidence of people should read as ordinary civic care rather than a sterile symbolic tableau.",
      "source": { "type": "creative-policy", "reference": "planning/reel-01-cinematic-direction-plan.md" }
    },
    {
      "id": "smoke-motion-provisional-material-rule",
      "state": "provisional",
      "scope": { "type": "material", "material": "smoke" },
      "path": "motion.smoke.strategy",
      "value": "low-opacity-irregular-drift",
      "rationale": "Smoke should rise and drift with irregular density and restrained amplitude; the benchmark must establish a reusable extraction and motion lane before this becomes approved production knowledge.",
      "source": { "type": "creative-policy", "reference": "planning/reel-01-cinematic-direction-plan.md" }
    }
  ]
}
