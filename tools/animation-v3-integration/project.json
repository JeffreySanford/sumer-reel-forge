{
  "name": "animation-v3-integration",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/animation-v3-integration/src",
  "projectType": "library",
  "tags": ["type:integration", "scope:animation-v3"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tools/animation-v3-integration/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig tools/animation-v3-integration/tsconfig.json --test --test-concurrency=1 tools/animation-v3-integration/src/golden-fixture.test.ts tools/animation-v3-integration/src/v2-compatibility.test.ts tools/animation-v3-integration/src/inspection-integration.test.ts"
      }
    },
    "eslint:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"tools/animation-v3-integration/**/*.ts\""
      }
    }
  }
}
